inn","chapter":"Special Delivery","releaseDate":"2020-04-14","power":"Redeemer","difficulty":"Hard","perks":["hex_retribution","dead_man_switch"],"description":"A gunslinger who has adapted his harpoon gun for a new kind of hunt."},{"id":"trapper","name":"The Trapper","realName":"Evan MacMillan","chapter":"Dead by Daylight","releaseDate":"2016-06-14","power":"Bear Traps","difficulty":"Medium","perks":["unnerving_presence","hex_the_third_seal","agitation"],"description":"A hunter turned killer, using elaborate traps to ensnare his prey."},{"id":"plague","name":"The Plague","realName":"Adiris","chapter":"Plague","releaseDate":"2019-03-19","power":"Vile Purge","difficulty":"Medium","perks":["infectious_fright","corrupt_intervention","dark_devotion"],"description":"A corrupted priestess who spreads pestilence and sickness wherever she goes."}]